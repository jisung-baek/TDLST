{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TDLST",
  "version": "0.1.0",
  "identifier": "com.jisungbaek.tdlst",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TDLST",
        "width": 820,
        "height": 420,
        "minWidth": 560,
        "minHeight": 300,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "minimizable": false,
        "maximizable": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
